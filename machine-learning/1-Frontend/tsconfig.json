{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": { "@/*": ["./src/*"], "@shared/*": ["../3-Shared/*"] }
  },
  "include": ["src", "vite.config.ts", "../3-Shared/api-list.json", "../3-Shared/concept/*.json"]
}
