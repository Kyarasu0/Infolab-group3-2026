{
  "description": "AEで圧縮した潜在ベクトルをSVMに入れ、その後サブタイプをクラスタリングする",
  "anomaly_gate": true,
  "parameters": {
    "autoencoder": { "latent_dim": 4, "hidden_layers": 2 }
  },
  "pipeline": [
    { "model": "autoencoder" },
    { "model": "svm", "input": "latent" },
    { "model": "clustering", "input": "latent" }
  ]
}
